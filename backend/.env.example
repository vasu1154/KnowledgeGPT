# ============================================
# APPLICATION
# ============================================
APP_NAME=AI Knowledge Assistant
APP_VERSION=1.0.0
DEBUG=true
API_V1_PREFIX=/api/v1

# ============================================
# DATABASE — PostgreSQL
# ============================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledgegpt
DATABASE_ECHO=false

# ============================================
# JWT AUTHENTICATION
# ============================================
SECRET_KEY=your-super-secret-key-change-this-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# GEMINI API
# ============================================
GEMINI_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/embedding-001

# ============================================
# CHROMADB
# ============================================
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=knowledge_documents

# ============================================
# DOCUMENT PROCESSING
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ============================================
# REDIS & CELERY
# ============================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# RAG CONFIGURATION
# ============================================
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.5
